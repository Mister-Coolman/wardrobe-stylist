# mock = no network calls to Meta; real = Meta Model API
MODELS=mock
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=

# Auth.js (Google). AUTH_SECRET: `npx auth secret`
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Development / e2e only: sign in as this user without Google
DEV_USER_EMAIL=

# Supabase (server-only). Leave unset to use the local file store in .data/
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stretch features (off by default)
NEXT_PUBLIC_FEATURE_POLL=
NEXT_PUBLIC_FEATURE_STYLE=
