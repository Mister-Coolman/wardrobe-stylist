# mock = no network calls to Meta; real = Meta Model API
MODELS=mock
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=

# Auth.js (Google). AUTH_SECRET: `npx auth secret`
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Development / e2e only: sign in as this user without Google
DEV_USER_EMAIL=

# Supabase (server-only). Leave unset to use the local file store in .data/
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stretch features (off by default)
NEXT_PUBLIC_FEATURE_POLL=
NEXT_PUBLIC_FEATURE_STYLE=

# WhatsApp Cloud API (docs/notes/whatsapp-setup.md). WHATSAPP_TEMPLATE: the approved template for messages outside the 24-hour window, e.g. hello_world
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_TEMPLATE=
# Vercel cron sends it as a bearer token for the morning note
CRON_SECRET=

# Finding pieces online (SerpApi's Google Shopping engine)
SERPAPI_KEY=

# "Try the demo": the user whose confirmed closet each demo visitor gets a copy of. Unset hides the button.
DEMO_SOURCE_USER=
